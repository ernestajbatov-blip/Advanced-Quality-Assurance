{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/api/schema/stryker-core.json",
  "mutate": [
    "src/axios/**/*.js",
    "src/states/**/*.{js,jsx}",
    "src/components/Login/**/*.jsx",
    "src/components/NotificationBell/**/*.jsx",
    "!src/states/UniversalActivityTracker.jsx",
    "!src/**/__tests__/**"
  ],
  "plugins": ["@stryker-mutator/vitest-runner"],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.stryker.config.js"
  },
  "reporters": [
    "html",
    "json",
    "clear-text",
    "progress"
  ],
  "htmlReporter": {
    "fileName": "QA/test-reports/mutation/index.html"
  },
  "jsonReporter": {
    "fileName": "QA/test-reports/mutation/results.json"
  },
  "timeoutMS": 30000,
  "timeoutFactor": 1.5,
  "concurrency": 4,
  "disableTypeChecks": true
}
